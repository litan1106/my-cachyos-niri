binds {

    // ─── Hotkey Guide ───
    Mod+K { show-hotkey-overlay; }

    // ─── Navigating (Omarchy Keymap) ───
    Mod+Space                           hotkey-overlay-title="Open App Launcher" { spawn-sh "qs -c noctalia-shell ipc call launcher toggle"; }
    Mod+ALT+Space                       hotkey-overlay-title="Omarchy Control Menu" { spawn-sh "qs -c noctalia-shell ipc call controlCenter toggle"; }
    Mod+ESCAPE                          hotkey-overlay-title="System Menu" { spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"; }
    Mod+CTRL+L                          hotkey-overlay-title="Lock Computer" { spawn-sh "qs -c noctalia-shell ipc call lockScreen lock"; }
    Mod+W                               { close-window; }
    CTRL+ALT+Delete                     { quit; }
    Mod+T                               { toggle-window-floating; }
    Mod+F                               { fullscreen-window; }
    Mod+ALT+F                           { maximize-column; }
    Mod+CTRL+F                          { maximize-window-to-edges; }

    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }

    Mod+TAB                             { focus-workspace-down; }
    Mod+Shift+TAB                       { focus-workspace-up; }
    Mod+CTRL+TAB                        { focus-workspace-previous; }

    Mod+Shift+1                         { move-column-to-workspace 1; }
    Mod+Shift+2                         { move-column-to-workspace 2; }
    Mod+Shift+3                         { move-column-to-workspace 3; }
    Mod+Shift+4                         { move-column-to-workspace 4; }

    Mod+Shift+ALT+1                     { move-window-to-workspace 1; }
    Mod+Shift+ALT+2                     { move-window-to-workspace 2; }
    Mod+Shift+ALT+3                     { move-window-to-workspace 3; }
    Mod+Shift+ALT+4                     { move-window-to-workspace 4; }

    Mod+Shift+ALT+Left                  { move-column-to-monitor-left; }
    Mod+Shift+ALT+Right                 { move-column-to-monitor-right; }
    Mod+Shift+ALT+Up                    { move-column-to-monitor-up; }
    Mod+Shift+ALT+Down                  { move-column-to-monitor-down; }

    Mod+Left                            { focus-column-left; }
    Mod+Right                           { focus-column-right; }
    Mod+Up                              { focus-window-up; }
    Mod+Down                            { focus-window-down; }

    Mod+Shift+Left                      { move-column-left; }
    Mod+Shift+Right                     { move-column-right; }
    Mod+Shift+Up                        { move-window-up; }
    Mod+Shift+Down                      { move-window-down; }

    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }

    Mod+WheelScrollDown   cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp     cooldown-ms=150 { focus-workspace-up; }

    Mod+G                               { toggle-column-tabbed-display; }
    Mod+ALT+G                           { expel-window-from-column; }
    Mod+ALT+Tab                         { focus-window-down; }
    Mod+ALT+Left                        { consume-window-into-column; }
    Mod+ALT+Right                       { consume-window-into-column; }

    Mod+CTRL+Left                       { focus-column-left; }
    Mod+CTRL+Right                      { focus-column-right; }
    Mod+CTRL+Up                         { focus-window-up; }
    Mod+CTRL+Down                       { focus-window-down; }

    Mod+S                               { toggle-overview; }

    ALT+Tab                             { focus-column-right; }
    ALT+Shift+Tab                       { focus-column-left; }
    CTRL+ALT+Tab                        { focus-monitor-right; }
    CTRL+ALT+Shift+Tab                  { focus-monitor-left; }

    // ─── System Controls (Omarchy Keymap) ───
    Mod+CTRL+A                          hotkey-overlay-title="Audio Controls (wiremix)" { spawn "alacritty" "-e" "wiremix"; }
    Mod+CTRL+B                          hotkey-overlay-title="Bluetooth Controls (bluetui)" { spawn "alacritty" "-e" "bluetui"; }
    Mod+CTRL+W                          hotkey-overlay-title="Wifi Controls (impala)" { spawn "alacritty" "-e" "impala"; }
    Mod+CTRL+S                          hotkey-overlay-title="Share Menu (LocalSend)" { spawn "localsend"; }
    Mod+CTRL+T                          hotkey-overlay-title="Activity Monitor" { spawn "alacritty" "-e" "btop"; }
    Mod+CTRL+C                          hotkey-overlay-title="Interactive Capture" { screenshot; }

    // ─── Adjustments (Omarchy Keymap) ───
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume increase"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume decrease"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume muteOutput"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume muteInput"; }
    XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call brightness increase"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call brightness decrease"; }

    // ─── Launching Applications (Omarchy Keymap) ───
    Mod+Return                          hotkey-overlay-title="Open Terminal" { spawn "alacritty"; }
    Mod+ALT+Return                      hotkey-overlay-title="Open Tmux Terminal" { spawn "alacritty" "-e" "tmux"; }
    Mod+Shift+Return                    hotkey-overlay-title="Open Browser" { spawn "google-chrome-stable"; }
    Mod+Shift+ALT+B                     hotkey-overlay-title="Open Browser (Incognito)" { spawn "google-chrome-stable" "--incognito"; }
    Mod+Shift+F                         hotkey-overlay-title="File Manager" { spawn "nautilus"; }
    Mod+Shift+ALT+F                     hotkey-overlay-title="File Manager (CWD)" { spawn "nautilus"; }
    Mod+Shift+M                         hotkey-overlay-title="Open Spotify" { spawn "spotify"; }
    Mod+Shift+ALT+M                     hotkey-overlay-title="Open Cliamp" { spawn "alacritty" "-e" "cliamp"; }
    Mod+Shift+Slash                     hotkey-overlay-title="Open 1Password" { spawn "1password"; }
    Mod+Shift+N                         hotkey-overlay-title="Open Neovim" { spawn "alacritty" "-e" "nvim"; }
    Mod+Shift+C                         hotkey-overlay-title="Open HEY Calendar" { spawn "google-chrome-stable" "https://app.hey.com/calendar"; }
    Mod+Shift+E                         hotkey-overlay-title="Open HEY Mail" { spawn "google-chrome-stable" "https://app.hey.com/mail"; }
    Mod+Shift+A                         hotkey-overlay-title="Open ChatGPT" { spawn "google-chrome-stable" "https://chatgpt.com"; }
    Mod+Shift+ALT+A                     hotkey-overlay-title="Open Grok" { spawn "google-chrome-stable" "https://grok.com"; }
    Mod+Shift+G                         hotkey-overlay-title="Open Signal" { spawn "signal-desktop"; }
    Mod+Shift+Alt+G                     hotkey-overlay-title="Open WhatsApp" { spawn "google-chrome-stable" "https://web.whatsapp.com"; }
    Mod+Shift+Ctrl+G                    hotkey-overlay-title="Open Google Chat" { spawn "google-chrome-stable" "https://chat.google.com"; }
    Mod+Shift+D                         hotkey-overlay-title="Open LazyDocker" { spawn "alacritty" "-e" "lazydocker"; }
    Mod+Shift+O                         hotkey-overlay-title="Open Obsidian" { spawn "obsidian"; }
    Mod+Shift+W                         hotkey-overlay-title="Open Typora" { spawn "typora"; }
    Mod+Shift+X                         hotkey-overlay-title="Open X" { spawn "google-chrome-stable" "https://x.com"; }
    Mod+Shift+Y                         hotkey-overlay-title="Open YouTube" { spawn "google-chrome-stable" "https://youtube.com"; }

    // ─── Universal Clipboard & History (Omarchy Keymap) ───
    Mod+CTRL+V                          hotkey-overlay-title="Clipboard History" { spawn-sh "qs -c noctalia-shell ipc call launcher clipboard"; }

    // ─── Capture (Omarchy Keymap) ───
    Print                               { screenshot; }
    ALT+Print                           { screenshot-screen; }
    Mod+Print                           { screenshot-window; }

    // ─── Notifications (Omarchy Keymap) ───
    Mod+comma                           { spawn-sh "qs -c noctalia-shell ipc call notifications dismissOldest"; }
    Mod+Shift+comma                     { spawn-sh "qs -c noctalia-shell ipc call notifications dismissAll"; }
    Mod+CTRL+comma                      { spawn-sh "qs -c noctalia-shell ipc call notifications toggleDND"; }

    // ─── Toggles (Omarchy Keymap) ───
    Mod+CTRL+I                          { spawn-sh "qs -c noctalia-shell ipc call idleInhibitor toggle"; }
    Mod+CTRL+N                          { spawn-sh "qs -c noctalia-shell ipc call nightLight toggle"; }
    Mod+CTRL+Delete                     { power-off-monitors; }
    Mod+Shift+Space                     { spawn-sh "qs -c noctalia-shell ipc call bar toggle"; }
}
